# ----------------------------------------------------------------------
# Backend environment variables. Copy this file to backend/.env and fill in.
# Never commit backend/.env. The .gitignore prevents it.
# ----------------------------------------------------------------------

# --- Database -------------------------------------------------------
# Local: matches docker-compose.yml. Production: set to your Neon/Supabase URL.
DATABASE_URL=postgresql+asyncpg://fantasy:fantasy_dev_password@localhost:5432/fantasy_copilot

# --- App mode --------------------------------------------------------
# live   = hit real Yahoo + NBA APIs (only works during NBA season)
# replay = read recorded fixtures from backend/tests/fixtures/, AS_OF_DATE acts as "today"
APP_MODE=replay
AS_OF_DATE=2026-03-15

# --- Yahoo OAuth (Phase 2) ------------------------------------------
# From developer.yahoo.com/apps/<app-id>/
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must match a redirect URI registered on the Yahoo app. Set to your ngrok URL + /auth/yahoo/callback during dev.
YAHOO_REDIRECT_URI=https://<ngrok-id>.ngrok-free.app/auth/yahoo/callback

# --- Anthropic / Agent (Phase 4) ------------------------------------
ANTHROPIC_API_KEY=

# --- LangSmith tracing (Phase 4) ------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=fantasy-copilot-v2

# --- Tavily (Phase 7.5) — web search for news / injury / lineup status -
# Free tier: 1000 searches/month. Sign up at tavily.com.
TAVILY_API_KEY=

# --- JWT / cookies ---------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- Admin endpoints -------------------------------------------------
# Header secret required to call /admin/* endpoints
ADMIN_SECRET=
